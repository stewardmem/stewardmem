{
	"name": "stewardmem-shell",
	"version": "1.0.0",
	"private": true,
	"description": "The SvelteTauri shell: the typed-wire skeleton + the wizard renderer (the C9 consumer). A pure protocol client — zero business logic; every read is a typed kernel call.",
	"type": "module",
	"engines": {
		"node": ">=24 <27",
		"pnpm": ">=12 <13"
	},
	"packageManager": "pnpm@12.11.2",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/inject-csp.mjs",
		"preview": "vite preview",
		"gen:api": "openapi-typescript ../openapi.yaml -o src/lib/api/schema.d.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
		"tauri": "tauri"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"@zag-js/combobox": "^1.47.0",
		"@zag-js/dialog": "^1.47.0",
		"@zag-js/svelte": "^1.47.0",
		"highlight.js": "^11.12.0",
		"mermaid": "^12.3.0",
		"openapi-fetch": "^0.17.0",
		"svelte-exmarkdown": "^5.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.3",
		"@inlang/plugin-message-format": "^4.6.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.72.0",
		"@napi-rs/canvas": "^1.1.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@tauri-apps/cli": "^2.12.4",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^26.6.6",
		"@typescript-eslint/parser": "^8.72.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"axe-core": "^4.14.0",
		"cn": "^0.5.2",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
